From 64fd1bc9f06a5c82ea3f950c344c02cae95dcb1d Mon Sep 17 00:00:00 2001
From: Oliver Smith <osmith@sysmocom.de>
Date: Fri, 30 Oct 2026 15:26:11 +0100
Subject: [PATCH] debian: build with asan

---
 debian/rules | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/debian/rules b/debian/rules
index bbfaa0423..f1f503e93 100755
--- a/debian/rules
+++ b/debian/rules
@@ -15,3 +15,11 @@ override_dh_install:
 
 override_dh_auto_test:
 	cd obj-$(DEB_HOST_GNU_TYPE) && meson test -v --suite unit
+
+# Enable asan for osmocom:nightly:asan
+override_dh_auto_configure:
+	dh_auto_configure "$@" -- -Db_sanitize=address,undefined
+
+# Tests don't pass with asan
+override_dh_auto_test:
+	@echo "tests skipped"
-- 
